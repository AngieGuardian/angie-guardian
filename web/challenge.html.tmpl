<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Checking your browser…</title>
{{if .NoScript}}<noscript><meta http-equiv="refresh" content="{{.RefreshSeconds}};url={{.NoJSURL}}"></noscript>{{end}}
<style>
  body { font-family: system-ui, sans-serif; display: flex; align-items: center;
         justify-content: center; min-height: 100vh; margin: 0;
         background: #f4f4f5; color: #18181b; }
  main { text-align: center; padding: 2rem; max-width: 26rem; }
  .bar { width: min(20rem, 80%); height: 0.5rem; margin: 0 auto 1.5rem;
         background: #d4d4d8; border-radius: 999px; overflow: hidden; }
  .bar > i { display: block; height: 100%; width: 0; background: #2563eb;
             border-radius: 999px; transition: width 0.2s ease; }
  h1 { font-size: 1.25rem; margin: 0 0 0.5rem; }
  p { margin: 0.25rem 0; color: #71717a; font-size: 0.9rem; }
  #status { min-height: 1.2rem; }
  #retry { display: none; margin: 1rem auto 0; padding: 0.55rem 0.9rem;
           border: 0; border-radius: 0.4rem; background: #2563eb; color: white;
           font: inherit; cursor: pointer; }
  footer { margin-top: 2rem; font-size: 0.8rem; color: #52525b; line-height: 1.5; }
  footer a { color: #2563eb; font-weight: 600; text-decoration: none; }
  footer a:hover { text-decoration: underline; }
  @media (prefers-color-scheme: dark) {
    body { background: #18181b; color: #f4f4f5; }
    .bar { background: #3f3f46; }
    footer { color: #a1a1aa; }
    footer a { color: #60a5fa; }
  }
</style>
</head>
<body>
<main>
  <div class="bar" role="progressbar" aria-label="Verification progress"
       aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="bar">
    <i id="fill"></i>
  </div>
  <h1>Checking your browser…</h1>
  <p>This site verifies visitors with a short proof-of-work computation.
     No personal data is collected.</p>
  <p id="status" role="status">Starting…</p>
  <button id="retry" type="button">Try verification again</button>
  <noscript>
    {{if .NoScript}}
    <p>JavaScript is disabled. You will be let through automatically in
       about {{.RefreshSeconds}} seconds.</p>
    {{else}}
    <p>JavaScript is required to access this site.</p>
    {{end}}
  </noscript>
  <footer>
    <p>Protected by <a href="https://angieguardian.org/" rel="noopener noreferrer">Angie Guardian</a></p>
    <p>AGPL-3.0, © <a href="https://melroy.org" rel="noopener noreferrer">Melroy van den Berg</a></p>
  </footer>
</main>
<script id="guardian-data" type="application/json">{{.JSON}}</script>
<script>
(() => {
  "use strict";
  const data = JSON.parse(document.getElementById("guardian-data").textContent);
  const status = document.getElementById("status");
  const retry = document.getElementById("retry");
  const bar = document.getElementById("bar");
  const fill = document.getElementById("fill");
  // Expected hashes for this difficulty (one per required leading zero bit).
  // Progress is probabilistic: the odds the puzzle is solved by `tried`
  // attempts is 1 - e^(-tried/expected), so we fill the bar by that curve and
  // cap it below 100% until a nonce is actually found. It gives a rough "how
  // far along" feel without claiming a false ETA.
  const setProgress = (pct) => {
    fill.style.width = pct + "%";
    bar.setAttribute("aria-valuenow", Math.round(pct));
  };

  // The solver runs a pure-JS SHA-256 rather than crypto.subtle.digest: a
  // synchronous call is ~7x faster than an awaited WebCrypto round trip per
  // tiny message (narrowing the honest-browser vs native-bot cost gap), and
  // it also works on plain-http origins where crypto.subtle is unavailable.
  const workerSrc = `
    "use strict";
    const K = new Uint32Array([
      0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
      0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
      0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
      0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
      0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
      0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
      0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
      0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2]);
    const w = new Uint32Array(64);
    const buf = new Uint8Array(256);
    const rotr = (x, n) => (x >>> n) | (x << (32 - n));
    // SHA-256 (FIPS 180-4) of an ASCII string (the hex challenge + a decimal
    // nonce is always ASCII), returning only the first hash word: 32 bits is
    // more than any allowed difficulty.
    const sha256w0 = (msg) => {
      const len = msg.length;
      const total = ((len + 9 + 63) >> 6) << 6;
      for (let i = 0; i < len; i++) buf[i] = msg.charCodeAt(i);
      buf.fill(0, len, total);
      buf[len] = 0x80;
      const bitLen = len * 8;
      buf[total - 2] = (bitLen >>> 8) & 0xff;
      buf[total - 1] = bitLen & 0xff;
      let h0=0x6a09e667,h1=0xbb67ae85,h2=0x3c6ef372,h3=0xa54ff53a,
          h4=0x510e527f,h5=0x9b05688c,h6=0x1f83d9ab,h7=0x5be0cd19;
      for (let off = 0; off < total; off += 64) {
        for (let i = 0; i < 16; i++) {
          const j = off + 4 * i;
          w[i] = (buf[j] << 24) | (buf[j+1] << 16) | (buf[j+2] << 8) | buf[j+3];
        }
        for (let i = 16; i < 64; i++) {
          const a = w[i-15], b = w[i-2];
          const s0 = rotr(a,7) ^ rotr(a,18) ^ (a >>> 3);
          const s1 = rotr(b,17) ^ rotr(b,19) ^ (b >>> 10);
          w[i] = (w[i-16] + s0 + w[i-7] + s1) | 0;
        }
        let a=h0,b=h1,c=h2,d=h3,e=h4,f=h5,g=h6,h=h7;
        for (let i = 0; i < 64; i++) {
          const S1 = rotr(e,6) ^ rotr(e,11) ^ rotr(e,25);
          const ch = (e & f) ^ (~e & g);
          const t1 = (h + S1 + ch + K[i] + w[i]) | 0;
          const S0 = rotr(a,2) ^ rotr(a,13) ^ rotr(a,22);
          const maj = (a & b) ^ (a & c) ^ (b & c);
          const t2 = (S0 + maj) | 0;
          h=g; g=f; f=e; e=(d+t1)|0; d=c; c=b; b=a; a=(t1+t2)|0;
        }
        h0=(h0+a)|0; h1=(h1+b)|0; h2=(h2+c)|0; h3=(h3+d)|0;
        h4=(h4+e)|0; h5=(h5+f)|0; h6=(h6+g)|0; h7=(h7+h)|0;
      }
      return h0 >>> 0;
    };

    self.onmessage = (e) => {
      const { challenge, bits, start, stride } = e.data;
      // A hash meets the difficulty when its first word has >= bits leading
      // zeros; difficulty is capped at 32 bits so one word always suffices.
      // (JS >>> takes the shift count mod 32, so bits=32 needs its own case.)
      const limit = bits >= 32 ? 0 : (0xffffffff >>> bits);
      const batch = 4096;
      for (let nonce = start; ; ) {
        for (let i = 0; i < batch; i++, nonce += stride) {
          if (sha256w0(challenge + nonce) <= limit) {
            self.postMessage({ nonce: String(nonce) });
            return;
          }
        }
        self.postMessage({ tried: batch });
      }
    };
  `;
  const workers = [];
  const started = performance.now();
  let total = 0;
  let solution = null;
  let redeeming = false;

  const stopWorkers = () => workers.splice(0).forEach((w) => w.terminate());
  const retryAfterMS = (value) => {
    if (!value) return 0;
    const seconds = Number(value);
    if (Number.isFinite(seconds)) return Math.max(0, seconds * 1000);
    const date = Date.parse(value);
    return Number.isNaN(date) ? 0 : Math.max(0, date - Date.now());
  };
  const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
  const redeem = async () => {
    if (!solution || redeeming) return;
    redeeming = true;
    retry.style.display = "none";
    setProgress(100);
    const body = {
      challenge_id: data.challenge_id,
      elapsed_ms: Math.round(performance.now() - started),
    };
    body[solution.kind] = solution.value;
    for (let attempt = 0; attempt < 8; attempt++) {
      status.textContent = attempt ? "Verifier busy; retrying…" : "Verifying…";
      try {
        const resp = await fetch(data.pass_url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        if (resp.ok) { location.reload(); return; }
        if (resp.status === 409) {
          const result = await resp.json();
          if (result.reason === "network_handover" && result.retry_url) {
            status.textContent = "Network changed; restarting verification…";
            location.replace(result.retry_url);
            return;
          }
        }
        if (resp.status !== 429 && resp.status !== 503) break;
        // Keep the same proof and challenge: a busy or rate-limited verifier
        // does not consume it. Retry-After is combined with capped exponential
        // backoff and 0–1500 ms of jitter so many tabs do not retry in lock-step.
        const serverDelay = retryAfterMS(resp.headers.get("Retry-After"));
        const exponential = Math.min(250 * Math.pow(2, attempt), 8000);
        await wait(Math.max(serverDelay, exponential) + Math.random() * 1500);
      } catch (_) {
        break;
      }
    }
    redeeming = false;
    status.textContent = "Verification failed. Please reload this page.";
    retry.style.display = "block";
  };
  retry.addEventListener("click", redeem);
  const finish = (kind, value) => {
    if (solution) return;
    solution = { kind, value };
    stopWorkers();
    redeem();
  };
  const fallbackOrFail = () => {
    stopWorkers();
    if (data.noscript_fallback && data.noscript_url) {
      status.textContent = "This browser cannot run the solver. Waiting for fallback…";
      const remaining = Math.max(0, data.noscript_wait_seconds * 1000 - (performance.now() - started));
      setTimeout(() => { location.href = data.noscript_url; }, remaining);
      return;
    }
    status.textContent = "This browser cannot run the required solver.";
  };

  if ((data.algorithm || "sha256") === "argon2id") {
    if (!(window.Worker && window.WebAssembly && WebAssembly.instantiate)) {
      fallbackOrFail();
      return;
    }
    status.textContent = "Computing a memory-hard proof…";
    setProgress(15);
    try {
      const w = new Worker(data.worker_url);
      w.onmessage = (e) => {
        if (e.data.proof) { setProgress(90); finish("proof", e.data.proof); return; }
        status.textContent = "Solver error: " + (e.data.error || "unknown failure");
        fallbackOrFail();
      };
      w.onerror = fallbackOrFail;
      w.postMessage({
        challenge: data.challenge,
        salt: data.salt,
        memory_kib: data.memory_kib,
        iterations: data.iterations,
        wasm_url: data.wasm_url,
      });
      workers.push(w);
    } catch (_) {
      fallbackOrFail();
    }
    return;
  }

  if (!window.Worker) { fallbackOrFail(); return; }
  const expected = Math.pow(2, data.difficulty_bits);
  const blobURL = URL.createObjectURL(new Blob([workerSrc], { type: "text/javascript" }));
  const threads = Math.min(navigator.hardwareConcurrency || 2, 8);
  for (let i = 0; i < threads; i++) {
    const w = new Worker(blobURL);
    w.onmessage = (e) => {
      if (e.data.nonce !== undefined) { finish("nonce", e.data.nonce); return; }
      total += e.data.tried;
      setProgress(Math.min((1 - Math.exp(-total / expected)) * 100, 90));
      status.textContent = "Computing… " + total.toLocaleString() + " hashes";
    };
    w.onerror = fallbackOrFail;
    w.postMessage({ challenge: data.challenge, bits: data.difficulty_bits, start: i, stride: threads });
    workers.push(w);
  }
})();
</script>
</body>
</html>
