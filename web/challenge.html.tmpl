<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Checking your browser…</title>
{{if .NoScript}}<noscript><meta http-equiv="refresh" content="{{.RefreshSeconds}};url={{.NoJSURL}}"></noscript>{{end}}
<style>
  body { font-family: system-ui, sans-serif; display: flex; align-items: center;
         justify-content: center; min-height: 100vh; margin: 0;
         background: #f4f4f5; color: #18181b; }
  main { text-align: center; padding: 2rem; max-width: 26rem; }
  .bar { width: min(20rem, 80%); height: 0.5rem; margin: 0 auto 1.5rem;
         background: #d4d4d8; border-radius: 999px; overflow: hidden; }
  .bar > i { display: block; height: 100%; width: 0; background: #2563eb;
             border-radius: 999px; transition: width 0.2s ease; }
  h1 { font-size: 1.25rem; margin: 0 0 0.5rem; }
  p { margin: 0.25rem 0; color: #71717a; font-size: 0.9rem; }
  #status { min-height: 1.2rem; }
  @media (prefers-color-scheme: dark) {
    body { background: #18181b; color: #f4f4f5; }
    .bar { background: #3f3f46; }
  }
</style>
</head>
<body>
<main>
  <div class="bar" role="progressbar" aria-label="Verification progress"
       aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="bar">
    <i id="fill"></i>
  </div>
  <h1>Checking your browser…</h1>
  <p>This site verifies visitors with a short proof-of-work computation.
     No personal data is collected.</p>
  <p id="status" role="status">Starting…</p>
  <noscript>
    {{if .NoScript}}
    <p>JavaScript is disabled — you will be let through automatically in
       about {{.RefreshSeconds}} seconds.</p>
    {{else}}
    <p>JavaScript is required to access this site.</p>
    {{end}}
  </noscript>
</main>
<script id="guardian-data" type="application/json">{{.JSON}}</script>
<script>
(() => {
  "use strict";
  const data = JSON.parse(document.getElementById("guardian-data").textContent);
  const status = document.getElementById("status");
  const bar = document.getElementById("bar");
  const fill = document.getElementById("fill");
  // Expected hashes for this difficulty. Progress is probabilistic: the odds
  // the puzzle is solved by `tried` attempts is 1 - e^(-tried/expected), so we
  // fill the bar by that curve and cap it below 100% until a nonce is actually
  // found. It gives a rough "how far along" feel without claiming a false ETA.
  const expected = Math.pow(16, data.difficulty);
  const setProgress = (pct) => {
    fill.style.width = pct + "%";
    bar.setAttribute("aria-valuenow", Math.round(pct));
  };
  if (!self.crypto || !crypto.subtle) {
    status.textContent = "A secure (HTTPS) connection is required for verification.";
    return;
  }

  const workerSrc = `
    self.onmessage = async (e) => {
      const { challenge, difficulty, start, stride } = e.data;
      const enc = new TextEncoder();
      const prefix = "0".repeat(difficulty);
      const hexBytes = Math.ceil(difficulty / 2);
      let tried = 0;
      for (let nonce = start; ; nonce += stride) {
        const digest = new Uint8Array(
          await crypto.subtle.digest("SHA-256", enc.encode(challenge + nonce)));
        let hex = "";
        for (let i = 0; i < hexBytes; i++) hex += digest[i].toString(16).padStart(2, "0");
        if (hex.startsWith(prefix)) { self.postMessage({ nonce: String(nonce) }); return; }
        if (++tried % 2000 === 0) self.postMessage({ tried: 2000 });
      }
    };
  `;
  const blobURL = URL.createObjectURL(new Blob([workerSrc], { type: "text/javascript" }));
  const threads = Math.min(navigator.hardwareConcurrency || 2, 8);
  const workers = [];
  const started = performance.now();
  let total = 0;
  let done = false;

  const finish = async (nonce) => {
    if (done) return;
    done = true;
    workers.forEach((w) => w.terminate());
    setProgress(100);
    status.textContent = "Verifying…";
    try {
      const resp = await fetch(data.pass_url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          challenge_id: data.challenge_id,
          nonce: nonce,
          elapsed_ms: Math.round(performance.now() - started),
        }),
      });
      if (resp.ok) { location.reload(); return; }
    } catch (_) { /* fall through */ }
    status.textContent = "Verification failed — please reload this page.";
  };

  for (let i = 0; i < threads; i++) {
    const w = new Worker(blobURL);
    w.onmessage = (e) => {
      if (e.data.nonce !== undefined) { finish(e.data.nonce); return; }
      total += e.data.tried;
      setProgress(Math.min((1 - Math.exp(-total / expected)) * 100, 90));
      status.textContent = "Computing… " + total.toLocaleString() + " hashes";
    };
    w.onerror = () => { status.textContent = "Solver error — please reload this page."; };
    w.postMessage({ challenge: data.challenge, difficulty: data.difficulty, start: i, stride: threads });
    workers.push(w);
  }
})();
</script>
</body>
</html>
