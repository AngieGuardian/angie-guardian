# Angie Guardian anomaly trainer settings.
# Install as /etc/guardian/trainer.env, owned root:root and mode 0600.

# Space-separated normalized hostnames that MUST appear in the candidate.
# The job refuses promotion if guardian-train drops any of them for thin data.
GUARDIAN_TRAIN_EXPECTED_DOMAINS="REPLACE_WITH_EXPECTED_DOMAINS"

# The retained files matching this directory/pattern form the complete training
# window on every run. Configure logrotate retention to keep a representative
# 7-14 day window. The helper transparently reads plain files and *.gz files.
# If this directory also contains unprotected vhosts, use a narrower pattern:
# their empty guardian_action is invalid input by design.
GUARDIAN_TRAIN_LOG_DIR=/var/log/angie
GUARDIAN_TRAIN_LOG_PATTERN="*.access.json*"

# Per-domain and automatic route/method-segment floors. At most the busiest
# configured number of sufficiently frequent segments is retained per domain.
GUARDIAN_TRAIN_MIN_REQUESTS=5000
GUARDIAN_TRAIN_MIN_SEGMENT_REQUESTS=500
GUARDIAN_TRAIN_MAX_SEGMENTS=128

# Strict JSON/schema failures tolerated across the complete input. Records
# intentionally filtered by status or guardian_action do not count as invalid.
GUARDIAN_TRAIN_MAX_INVALID=0

# Candidate comparison uses the training window unless this pattern selects a
# separate validation set. Promotion fails when either absolute drift limit is
# exceeded for a domain, or the comparison sample is too small.
GUARDIAN_TRAIN_COMPARE_LOG_PATTERN="*.access.json*"
GUARDIAN_TRAIN_COMPARE_MIN_REQUESTS=500
GUARDIAN_TRAIN_MAX_MEAN_DELTA=0.10
GUARDIAN_TRAIN_MAX_P95_DELTA=0.15

# Must match waf.anomaly.model in guardian.yaml and stay below /etc/guardian.
GUARDIAN_TRAIN_LIVE_MODEL=/etc/guardian/model.json
