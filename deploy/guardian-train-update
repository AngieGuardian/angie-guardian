#!/usr/bin/env bash
# Angie Guardian anomaly-model training, comparison, and atomic promotion.

set -Eeuo pipefail

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

log_dir=${GUARDIAN_TRAIN_LOG_DIR:-/var/log/angie}
log_pattern=${GUARDIAN_TRAIN_LOG_PATTERN:-*.access.json*}
compare_pattern=${GUARDIAN_TRAIN_COMPARE_LOG_PATTERN:-$log_pattern}
expected_domains=${GUARDIAN_TRAIN_EXPECTED_DOMAINS:-}
min_requests=${GUARDIAN_TRAIN_MIN_REQUESTS:-5000}
min_segment_requests=${GUARDIAN_TRAIN_MIN_SEGMENT_REQUESTS:-500}
max_segments=${GUARDIAN_TRAIN_MAX_SEGMENTS:-128}
max_invalid=${GUARDIAN_TRAIN_MAX_INVALID:-0}
compare_min_requests=${GUARDIAN_TRAIN_COMPARE_MIN_REQUESTS:-500}
max_mean_delta=${GUARDIAN_TRAIN_MAX_MEAN_DELTA:-0.10}
max_p95_delta=${GUARDIAN_TRAIN_MAX_P95_DELTA:-0.15}
live_model=${GUARDIAN_TRAIN_LIVE_MODEL:-/etc/guardian/model.json}
staging_dir=/var/lib/guardian-training
candidate=${staging_dir}/model.candidate.json
train_report=${staging_dir}/training-report.json
compare_report=${staging_dir}/comparison-report.json
previous=${staging_dir}/model.previous.json
next_model=${live_model}.next

fail() {
  printf 'guardian-train update: %s\n' "$*" >&2
  exit 1
}

positive_integer() { [[ $1 =~ ^[1-9][0-9]*$ ]]; }
nonnegative_integer() { [[ $1 =~ ^[0-9]+$ ]]; }
unit_float() { [[ $1 =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]]; }

[[ -d $log_dir ]] || fail "log directory does not exist: ${log_dir}"
[[ $expected_domains ]] || fail "GUARDIAN_TRAIN_EXPECTED_DOMAINS is empty"
[[ $expected_domains != *REPLACE_WITH* ]] || fail "replace the example expected domains in /etc/guardian/trainer.env"
positive_integer "$min_requests" || fail "GUARDIAN_TRAIN_MIN_REQUESTS must be a positive integer"
positive_integer "$min_segment_requests" || fail "GUARDIAN_TRAIN_MIN_SEGMENT_REQUESTS must be a positive integer"
positive_integer "$max_segments" || fail "GUARDIAN_TRAIN_MAX_SEGMENTS must be a positive integer"
((max_segments <= 4096)) || fail "GUARDIAN_TRAIN_MAX_SEGMENTS must not exceed 4096"
nonnegative_integer "$max_invalid" || fail "GUARDIAN_TRAIN_MAX_INVALID must be a non-negative integer"
positive_integer "$compare_min_requests" || fail "GUARDIAN_TRAIN_COMPARE_MIN_REQUESTS must be a positive integer"
unit_float "$max_mean_delta" || fail "GUARDIAN_TRAIN_MAX_MEAN_DELTA must be between 0 and 1"
unit_float "$max_p95_delta" || fail "GUARDIAN_TRAIN_MAX_P95_DELTA must be between 0 and 1"
[[ $live_model == /etc/guardian/* ]] || fail "GUARDIAN_TRAIN_LIVE_MODEL must stay below /etc/guardian"
[[ -d $(dirname "$live_model") ]] || fail "live model directory does not exist: $(dirname "$live_model")"

trainer_version=$(/usr/local/bin/guardian-train -version)
daemon_version=$(/usr/local/bin/guardiand -version)
trainer_version=${trainer_version#guardian-train }
daemon_version=${daemon_version#guardiand }
[[ $trainer_version && $trainer_version == "$daemon_version" ]] || fail \
  "guardian-train (${trainer_version}) and guardiand (${daemon_version}) must come from the same release"

mapfile -d '' -t inputs < <(
  find "$log_dir" -maxdepth 1 -type f -name "$log_pattern" -print0 | sort -z
)
((${#inputs[@]} > 0)) || fail "no logs match ${log_dir}/${log_pattern}"

train_args=(
  train
  -out "$candidate"
  -report "$train_report"
  -min-requests "$min_requests"
  -min-segment-requests "$min_segment_requests"
  -max-segments "$max_segments"
  -max-invalid "$max_invalid"
)
for domain in $expected_domains; do
  train_args+=(-require-domain "$domain")
done

printf 'training from %d log file(s) in %s\n' "${#inputs[@]}" "$log_dir"
/usr/local/bin/guardian-train "${train_args[@]}" "${inputs[@]}"

model_size=$(stat -c %s -- "$candidate")
((model_size <= 64 * 1024 * 1024)) || fail \
  "candidate exceeds guardiand's 64 MiB model limit"

if [[ -f $live_model ]]; then
  mapfile -d '' -t compare_inputs < <(
    find "$log_dir" -maxdepth 1 -type f -name "$compare_pattern" -print0 | sort -z
  )
  ((${#compare_inputs[@]} > 0)) || fail "no comparison logs match ${log_dir}/${compare_pattern}"
  printf 'comparing candidate against live model with %d log file(s)\n' "${#compare_inputs[@]}"
  /usr/local/bin/guardian-train compare \
    -current "$live_model" \
    -candidate "$candidate" \
    -report "$compare_report" \
    -min-requests "$compare_min_requests" \
    -max-mean-delta "$max_mean_delta" \
    -max-p95-delta "$max_p95_delta" \
    -max-invalid "$max_invalid" \
    "${compare_inputs[@]}"
  install -o root -g root -m600 -- "$live_model" "$previous"
else
  printf 'no live model exists; skipping candidate comparison for initial promotion\n'
fi

trap 'rm -f -- "$next_model"' EXIT
install -o root -g guardian -m640 -- "$candidate" "$next_model"
mv -fT -- "$next_model" "$live_model"

printf 'promoted model to %s; guardiand will detect it within 10 seconds\n' "$live_model"
