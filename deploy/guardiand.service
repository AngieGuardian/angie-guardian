[Unit]
Description=Angie Guardian sidecar (WAF + proof-of-work bot firewall)
Documentation=https://github.com/melroy89/angie-guardian
After=network.target
Before=angie.service

[Service]
# sd_notify startup gating + watchdog. guardiand signals READY=1 only once both
# listeners actually answer /healthz, so `systemctl start` blocks until the
# service is really serving (not merely forked), and the watchdog restarts a
# wedged process instead of leaving it "active" but not protecting. The daemon
# auto-detects $NOTIFY_SOCKET, so this needs no rebuild and no config.
#
# This gate is LIVENESS: it intentionally does not wait on the store, since
# Guardian serves fail-open and a store outage must not stop the unit from
# starting. "active" therefore means serving, not "the store is reachable" —
# poll GET /readyz on the admin listener, or alert on guardian_store_up
# (deploy/alerts.yaml), for that.
Type=notify
WatchdogSec=30s

# Validate the config before (re)starting, so a bad edit fails the unit with a
# clear reason instead of crash-looping the daemon (and, with fail-open, 500ing
# the site during the restart window).
#
# `guardiand -t` alone would default to this same path, but keep -config
# explicit here: ExecStartPre must validate exactly the file ExecStart runs.
# If you point ExecStart at a different config, the line below has to follow it,
# and relying on the default would silently preflight the wrong file instead.
ExecStartPre=/usr/local/bin/guardiand -config /etc/guardian/guardian.yaml -t
ExecStart=/usr/local/bin/guardiand -config /etc/guardian/guardian.yaml
# `systemctl reload guardiand` hot-applies config edits via SIGHUP (domains,
# lists, thresholds, difficulty; not listeners/store/keys). A config that
# fails validation is rejected and the running config stays active.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

User=guardian
Group=guardian
# Generated state (signing key, rotated-key archive, admin token, the store)
# lives under /var/lib/guardian, created and owned guardian:guardian by
# StateDirectory. Mode 0700: the state dir holds the signing key.
StateDirectory=guardian
StateDirectoryMode=0700
# /etc/guardian is immutable configuration: READ-ONLY for the service, so a
# compromised daemon cannot rewrite its own policy. Mode 0710 gives the
# service group traverse-only access (no listing, no writes); the files
# themselves are root:guardian 0640. systemd applies this mode but leaves the
# directory owned root:root, so installation must set the group explicitly:
# chown root:guardian /etc/guardian (the install commands in the production
# guide do this). Note ReadWritePaths would NOT be a substitute for write
# access here: it only relaxes the systemd sandbox and never overrides normal
# Unix ownership/mode checks.
ConfigurationDirectory=guardian
ConfigurationDirectoryMode=0710

# Admin API bearer token: simplest is admin.token_file in guardian.yaml
# (auto-generated 0600 on first start; point it into /var/lib/guardian, the
# example config does). To manage the token yourself instead, keep it out of
# the YAML and inject via env:
# Environment=ADMIN_TOKEN=...    (better: EnvironmentFile=/etc/guardian/env)
# Environment=REDIS_PASSWORD=... (when using the redis store backend)

# Throughput tuning (optional). At tens of thousands of req/s the read paths
# are GC-bound; a higher GOGC runs the GC less often (~20% more read throughput
# in benchmarks) at the cost of a larger heap. On a host or container where
# guardiand owns the memory, pair it with GOMEMLIMIT as a safety cap so the
# bigger heap can't OOM: the runtime does extra GC only if it approaches the
# limit. GOMEMLIMIT is a SOFT limit; leave 5-10% headroom for memory the runtime
# doesn't track, and never set it to total RAM (a too-tight limit can thrash the
# GC into a slowdown worse than an OOM). Skip GOMEMLIMIT if this host's memory is
# shared with other processes. Measure with guardian-loadtest; the default is
# fine at typical rates. See docs "GC tuning for peak throughput".
# Environment=GOGC=800
# Environment=GOMEMLIMIT=2GiB     (set to ~90% of guardiand's memory budget)

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

# Kernel block offload (enforcement.nftables.enabled). Uncomment these to let
# guardiand drop blocked clients in nftables so their packets never reach
# Angie. The daemon programs the kernel over netlink (AF_NETLINK) and needs
# CAP_NET_ADMIN in the namespace where client traffic arrives; on bare metal
# that is the host namespace, so no netns: is required. NoNewPrivileges above
# still holds: ambient capabilities are granted, not gained via setuid.
# AmbientCapabilities=CAP_NET_ADMIN
# CapabilityBoundingSet=CAP_NET_ADMIN
# RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
