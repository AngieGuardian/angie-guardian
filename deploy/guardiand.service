[Unit]
Description=Angie Guardian sidecar (WAF + proof-of-work bot firewall)
Documentation=https://github.com/melroy89/angie-guardian
After=network.target
Before=angie.service

[Service]
# sd_notify readiness + watchdog. guardiand signals READY=1 only once both
# listeners actually answer /healthz, so `systemctl start` blocks until the
# service is really serving (not merely forked), and the watchdog restarts a
# wedged process instead of leaving it "active" but not protecting. The daemon
# auto-detects $NOTIFY_SOCKET, so this needs no rebuild and no config.
Type=notify
WatchdogSec=30s

# Validate the config before (re)starting, so a bad edit fails the unit with a
# clear reason instead of crash-looping the daemon (and, with fail-open, 500ing
# the site during the restart window).
ExecStartPre=/usr/local/bin/guardiand -config /etc/guardian/guardian.yaml -t
ExecStart=/usr/local/bin/guardiand -config /etc/guardian/guardian.yaml
# `systemctl reload guardiand` hot-applies config edits via SIGHUP (domains,
# lists, thresholds, difficulty; not listeners/store/keys). A config that
# fails validation is rejected and the running config stays active.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

User=guardian
Group=guardian
StateDirectory=guardian
ConfigurationDirectory=guardian
# guardiand writes the signing key + rotated-key archive under /etc/guardian;
# grant write to that config dir (default mode is read-only for the service).
ConfigurationDirectoryMode=0750
ReadWritePaths=/etc/guardian

# Admin API bearer token: simplest is admin.token_file in guardian.yaml
# (auto-generated 0600 on first start; ReadWritePaths above already allows
# it). To manage the token yourself instead, keep it out of the YAML and
# inject via env:
# Environment=ADMIN_TOKEN=...    (better: EnvironmentFile=/etc/guardian/env)
# Environment=REDIS_PASSWORD=... (when using the redis store backend)

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

# Kernel block offload (enforcement.nftables.enabled). Uncomment these to let
# guardiand drop blocked clients in nftables so their packets never reach
# Angie. The daemon programs the kernel over netlink (AF_NETLINK) and needs
# CAP_NET_ADMIN in the namespace where client traffic arrives; on bare metal
# that is the host namespace, so no netns: is required. NoNewPrivileges above
# still holds: ambient capabilities are granted, not gained via setuid.
# AmbientCapabilities=CAP_NET_ADMIN
# CapabilityBoundingSet=CAP_NET_ADMIN
# RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
