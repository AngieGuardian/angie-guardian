{
  "__comment": "Angie Guardian dashboard. Import into Grafana and pick your Prometheus datasource. Scrape guardiand's admin listener (default 127.0.0.1:8072) /metrics endpoint.",
  "title": "Angie Guardian",
  "uid": "angie-guardian",
  "tags": ["angie", "guardian", "waf"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Decisions per second by action",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (action) (rate(guardian_decisions_total[$__rate_interval]))",
          "legendFormat": "{{action}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Decisions per second by reason",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (reason) (rate(guardian_decisions_total[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Evaluate() latency (auth hot path)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(guardian_evaluate_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(guardian_evaluate_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Challenge lifecycle per second",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(guardian_challenges_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "PoW solve time (client-reported)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(guardian_challenge_solve_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(guardian_challenge_solve_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Behavioural blocks placed per second by reason",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (reason) (rate(guardian_blocks_placed_total[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 7,
      "type": "heatmap",
      "title": "Anomaly score distribution",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (le) (rate(guardian_anomaly_score_bucket[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Store op latency p99 + error rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, op) (rate(guardian_store_op_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{op}}"
        },
        {
          "expr": "sum(rate(guardian_store_ops_total{status=\"error\"}[$__rate_interval]))",
          "legendFormat": "errors/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Store up (0 = failing open)",
      "description": "guardian_store_up is 1 when the store answered Guardian's last write/read-back probe. At 0 Guardian still serves every request, but single-spend, behavioural scoreboards and blocks have quietly stopped working. /healthz stays green in that state on purpose; /readyz does not. min() so one unhealthy replica cannot be averaged away.",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "min(guardian_store_up) by (backend)",
          "legendFormat": "{{backend}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "FAILING OPEN", "index": 0 },
                "1": { "text": "up", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Degradation signals",
      "description": "Mixed units on purpose: a 0-1 store error ratio, per-second shed and single-spend-CAS-failure rates, and the 0/1 offload health series, together so one incident reads in one place. Every series names its unit in the legend; compare shapes, not absolute values.",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(guardian_store_ops_total{status=\"error\"}[$__rate_interval])) / clamp_min(sum(rate(guardian_store_ops_total[$__rate_interval])), 0.001)",
          "legendFormat": "store error ratio (0-1)"
        },
        {
          "expr": "sum(rate(guardian_store_probe_total{status=\"error\"}[$__rate_interval]))",
          "legendFormat": "failed store probes /s"
        },
        {
          "expr": "sum(rate(guardian_shed_total{outcome=\"shed\"}[$__rate_interval]))",
          "legendFormat": "load shed /s"
        },
        {
          "expr": "sum(rate(guardian_challenges_total{outcome=\"spent_cas_failed\"}[$__rate_interval]))",
          "legendFormat": "single-spend CAS failures /s"
        },
        {
          "expr": "min(guardian_offload_healthy) by (sink)",
          "legendFormat": "offload healthy {{sink}} (0/1)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      }
    }
  ]
}
