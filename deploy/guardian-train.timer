[Unit]
Description=Weekly Angie Guardian anomaly-model training
Documentation=https://gitlab.melroy.org/melroy/angie-guardian/-/blob/main/docs/guide/production.md#running-the-anomaly-trainer

[Timer]
# A weekly default is deliberate: use a representative retained-log window,
# not a tight loop that quickly teaches transient traffic as normal.
OnCalendar=Sun *-*-* 03:15:00
RandomizedDelaySec=30m
Persistent=true
Unit=guardian-train.service

[Install]
WantedBy=timers.target
